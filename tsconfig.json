{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "./types.d.ts",
    "./*.js"
  ],
  "exclude": [
    "node_modules",
    "tests"
  ]
}
